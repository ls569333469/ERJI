FROM python:3.14-slim
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
RUN python -c "from websockets.asyncio.client import connect; import fastapi, psycopg, sqlalchemy, talib"
COPY pyproject.toml alembic.ini ./
COPY engine ./engine
COPY services ./services
COPY migrations ./migrations
COPY docs/analysis-registry.json docs/pd2-acceptance.json ./docs/
RUN useradd --uid 10001 --user-group --create-home erji
RUN chmod -R a+rX engine services migrations docs
USER erji
RUN python -c "import services.api.main, services.worker.main; from pathlib import Path; assert Path('docs/analysis-registry.json').is_file(); assert Path('docs/pd2-acceptance.json').is_file()"
CMD ["python","-m","uvicorn","services.api.main:app","--host","0.0.0.0","--port","18771"]

